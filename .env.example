# =====================================================================
# Leitstelle Bavaria Control – Konfiguration
# Diese Datei wird von ./install.sh automatisch als .env angelegt.
# Die .env enthält Geheimnisse: niemals veröffentlichen oder weitergeben!
# =====================================================================

# --- STRATO MySQL (zentrale Datenbank, liegt NICHT auf dem Dell Wyse) ---
# Zugangsdaten aus dem STRATO-Kundenbereich (Datenbankverwaltung).
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# disabled | preferred | required | verify_ca | verify_identity
DB_SSL_MODE=preferred
# Optional: Pfad zu einem CA-Zertifikat (für verify_ca / verify_identity)
DB_SSL_CA=

# --- Anwendung ---
# Zufälliger Schlüssel (mind. 32 Zeichen) – verschlüsselt Geheimnisse in der Datenbank.
# NICHT nachträglich ändern, sonst sind gespeicherte Geheimnisse nicht mehr lesbar.
APP_SECRET_KEY=
# Adresse des Panels im Tailscale-Netz, z. B. https://wyse.tailnet-name.ts.net
APP_BASE_URL=
SESSION_HOURS=12
COOKIE_SECURE=true
LOG_LEVEL=INFO

# --- Discord ---
# Discord Developer Portal → Anwendung → Bot → Token
DISCORD_BOT_TOKEN=
# Discord Developer Portal → Anwendung → OAuth2 → Client ID / Client Secret
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Server-ID des Discord-Servers "Leitstelle Bavaria"
DISCORD_GUILD_ID=
# Muss exakt im Developer Portal unter OAuth2 → Redirects eingetragen sein
DISCORD_REDIRECT_URI=
# Discord-ID des Inhabers – wird beim ersten Start als Teammitglied mit Vollzugriff angelegt
OWNER_DISCORD_ID=

# --- Netzwerk ---
# Tailscale-IP des Dell Wyse; das Panel lauscht nur auf dieser Adresse
BIND_ADDRESS=
